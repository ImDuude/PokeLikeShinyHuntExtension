{
  "manifest_version": 3,
  "name": "Pokelike Speed + Shiny Hunt",
  "version": "2.0.0",
  "description": "Fast resets and automatic Challenge shiny starter hunting for pokelike.xyz.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://pokelike.xyz/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Pokelike Speed + Shiny Hunt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://pokelike.xyz/*"],
    "js": ["content_bridge.js"],
    "run_at": "document_start"
  }],
  "author": "ImDuude (https://github.com/ImDuude)",
  "homepage_url": "https://github.com/ImDuude/PokeLikeShinyHuntExtension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
